# Padrao de edicao do laboratorio Jaspy.
# Mantem indentacao e fim de linha iguais entre VS Code, PlatformIO e git,
# evitando diff sujo por espaco em branco.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,cpp,h,hpp,ino}]
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4

[*.{md,markdown}]
# Dois espacos no fim da linha sao quebra de linha em Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml,ini}]
indent_size = 2

[Makefile]
indent_style = tab
